<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sql2Json.App.ViewModels"
        xmlns:views="using:Sql2Json.App.Views"
        xmlns:converters="using:Sql2Json.App.Converters"
        x:Class="Sql2Json.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Sql2Json"
        Icon="/Assets/icon.png"
        Width="1300" Height="820"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SemiColorBg0}">

    <Window.Resources>
        <converters:NavIndexConverter x:Key="NavIndexConverter" />
    </Window.Resources>

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="64,*">
        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{DynamicResource SemiColorBg1}"
                BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SemiColorBorder}">
            <DockPanel>
                <!-- 顶部 Logo -->
                <Border DockPanel.Dock="Top" Height="56" Margin="0,8,0,16">
                    <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- 底部设置按钮 -->
                <Button DockPanel.Dock="Bottom" Margin="8,0,8,12"
                        Command="{Binding NavToSettingsCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Classes="Tertiary" Padding="0,10" ToolTip.Tip="设置">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="设置" FontSize="9" HorizontalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                </Button>

                <!-- 导航按钮列表 -->
                <StackPanel Spacing="4" Margin="8,0">
                    <!-- 查询 -->
                    <Button Command="{Binding NavToQueryCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Classes="Tertiary" Padding="0,10" ToolTip.Tip="SQL 查询">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <TextBlock Text="▶" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="查询" FontSize="9" HorizontalAlignment="Center" Opacity="0.7" />
                        </StackPanel>
                    </Button>

                    <!-- 数据库 -->
                    <Button Command="{Binding NavToDatabaseCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Classes="Tertiary" Padding="0,10" ToolTip.Tip="数据库配置">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <TextBlock Text="🗄" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="数据库" FontSize="9" HorizontalAlignment="Center" Opacity="0.7" />
                        </StackPanel>
                    </Button>

                    <!-- 文件夹 -->
                    <Button Command="{Binding NavToFolderCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Classes="Tertiary" Padding="0,10" ToolTip.Tip="文件夹配置">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <TextBlock Text="📁" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="文件夹" FontSize="9" HorizontalAlignment="Center" Opacity="0.7" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 右侧内容区 -->
        <Panel Grid.Column="1">
            <!-- 页面 0：查询（左右分栏） -->
            <Grid ColumnDefinitions="1.2*,Auto,*" Margin="20,16"
                  IsVisible="{Binding SelectedNavIndex, Converter={StaticResource NavIndexConverter}, ConverterParameter=0}">
                <!-- 左侧：查询面板 -->
                <Border Grid.Column="0" CornerRadius="10" Padding="24"
                        Background="{DynamicResource SemiColorBg1}"
                        BoxShadow="0 2 8 0 #0A000000">
                    <views:QueryView DataContext="{Binding QueryViewModel}" />
                </Border>

                <!-- 分隔 -->
                <GridSplitter Grid.Column="1" Width="16" Background="Transparent" />

                <!-- 右侧：任务列表 -->
                <Border Grid.Column="2" CornerRadius="10" Padding="24"
                        Background="{DynamicResource SemiColorBg1}"
                        BoxShadow="0 2 8 0 #0A000000">
                    <views:TaskListView DataContext="{Binding TaskListViewModel}" />
                </Border>
            </Grid>

            <!-- 页面 1：数据库配置 -->
            <Border Margin="20,16" CornerRadius="10" Padding="32"
                    Background="{DynamicResource SemiColorBg1}"
                    BoxShadow="0 2 8 0 #0A000000"
                    IsVisible="{Binding SelectedNavIndex, Converter={StaticResource NavIndexConverter}, ConverterParameter=1}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="数据库配置" FontSize="20" FontWeight="Bold"
                               Margin="0,0,0,20" />
                    <views:DatabaseConfigView DataContext="{Binding DatabaseConfigViewModel}" />
                </DockPanel>
            </Border>

            <!-- 页面 2：文件夹配置 -->
            <Border Margin="20,16" CornerRadius="10" Padding="32"
                    Background="{DynamicResource SemiColorBg1}"
                    BoxShadow="0 2 8 0 #0A000000"
                    IsVisible="{Binding SelectedNavIndex, Converter={StaticResource NavIndexConverter}, ConverterParameter=2}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="文件夹配置" FontSize="20" FontWeight="Bold"
                               Margin="0,0,0,20" />
                    <views:FolderConfigView DataContext="{Binding FolderConfigViewModel}" />
                </DockPanel>
            </Border>

            <!-- 页面 3：设置 -->
            <Border Margin="20,16" CornerRadius="10" Padding="32"
                    Background="{DynamicResource SemiColorBg1}"
                    BoxShadow="0 2 8 0 #0A000000"
                    IsVisible="{Binding SelectedNavIndex, Converter={StaticResource NavIndexConverter}, ConverterParameter=3}">
                <views:SettingsView DataContext="{Binding SettingsViewModel}" />
            </Border>
        </Panel>
    </Grid>

</Window>
